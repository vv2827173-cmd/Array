class Solution {
    public int majorityElement(int[] arr) {
        if(arr.length==1) return arr[0];
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=-1){
                int count=1;
                for(int j=i+1;j<arr.length;j++){
                    if(arr[i]==arr[j]){
                        count++;
                        arr[j]=-1;
                        if(count>arr.length/2){
                            return arr[i];
                        }
                    }
                }
            }
        }
        return -1;
    }
}
                
                
    
        
        
    
