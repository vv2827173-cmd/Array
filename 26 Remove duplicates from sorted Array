class Solution {
    public int removeDuplicates(int[] nums) {
        if(nums.length==0){
            return 0;
        }
        int i=0;
        for(int j=0;j<nums.legth;j+1){
            if(nums[j]!=nums[i]){
                i++;
                nums[i]=nums[j];
            }
        }
      return i+1;  
    }
}
